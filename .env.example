# ==============================================================================
# MULTI-AGENT AI DEBATE ENGINE (v2.9.6) — ENVIRONMENT TEMPLATE
# Copy this file to '.env' for local runs: cp .env.example .env
# On Hugging Face Spaces or Kaggle, add these under Settings -> Secrets.
# ==============================================================================

# 1. Mandatory Access Password Gate (Required to unlock the UI)
CHK_PSSWD=your_secure_password_here

# 2. LLM Provider API Keys (Strict Dual-Provider Isolation)
GROQ_API_KEY=gsk_your_groq_api_key_here
GEMINI_API_KEY=AIza_your_gemini_api_key_here

# 3. Live Web & Academic Search API Keys
TAVILY_API_KEY=tvly-your_tavily_api_key_here
EXA_API_KEY=your_exa_api_key_here

# 4. Optional Engine Tuning Overrides
TRACE=true
DEFAULT_MAX_LOOPS=3
DEFAULT_WAIT_TIME_SEC=30
MAX_DAILY_DEBATES=5
DEFAULT_GROQ_MODEL=openai/gpt-oss-120b
DEFAULT_GEMINI_MODEL=gemini-2.5-flash